VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
ESTAT_APP_ID=
OPENAI_API_KEY=

# Google Maps Static API(衛星写真・有料・即時利用可)
# https://console.cloud.google.com/ でプロジェクト作成→課金有効化→
# "Maps Static API"を有効化→認証情報でAPIキーを発行
# 未設定でもアプリは動作する(Esri World Imageryにフォールバックする)
GOOGLE_MAPS_API_KEY=

# Google Street View Static API(現地の雰囲気を確認する追加情報・有料・即時利用可)
# GOOGLE_MAPS_API_KEYと同じキーでも動くが、専用キーを分けた場合はこちらに設定する
# 未設定時はGOOGLE_MAPS_API_KEYにフォールバックする
GOOGLE_STREET_VIEW_API_KEY=
